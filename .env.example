# Aegis works with Gemini, OpenAI, Anthropic, Azure OpenAI, AWS Bedrock, and Ollama.
# Auto-detection uses the first configured provider. This file can live in the
# project root or globally at ~/.aegis/.env.

# Gemini (default)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL=

# Ollama (local, no key)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: force a provider or model.
# AEGIS_PROVIDER=gemini
# AEGIS_MODEL=gemini-3.8-flash

# Optional: default Gemini ladder is gemini-3.8-flash -> gemini-3.5-flash-lite -> local.

# Optional: force a repair engine. "auto" | "ai" | "gemini" | "local"
# AEGIS_ENGINE=auto

# Optional: cap the self-healing loop (default: 3)
# AEGIS_MAX_ITERATIONS=3
