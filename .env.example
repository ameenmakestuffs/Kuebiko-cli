# Aegis uses Gemini as its primary repair brain.
# Get a key at https://aistudio.google.com/apikey
# This file can live in the project root or globally at ~/.aegis/.env
# GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=

# Optional: override the primary model (default: gemini-3.8-flash)
# Fallback ladder: gemini-3.8-flash -> gemini-3.5-flash-lite -> local repair
# GEMINI_MODEL=gemini-3.8-flash

# Optional: force a repair engine. "auto" | "gemini" | "local"
# AEGIS_ENGINE=auto

# Optional: cap the self-healing loop (default: 3)
# AEGIS_MAX_ITERATIONS=3
